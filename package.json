{
  "name": "realm-of-embers",
  "version": "0.1.0",
  "private": true,
  "description": "2.5D 經營 RPG — 打怪掉寶、交易、家園採礦伐木（致敬天堂 & RO 仙境傳說）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim:drops": "vite-node tools/simulate-drops.ts",
    "server": "vite-node server/main.ts",
    "sim:leveling": "vite-node tools/simulate-leveling.ts",
    "desktop": "vite build && electron .",
    "desktop:smoke": "vite build && ROE_SMOKE_TEST=smoke.png DISABLE_STEAM=1 electron .",
    "dist": "vite build && electron-builder --dir",
    "dist:win": "vite build && electron-builder --win --dir",
    "dist:linux": "vite build && electron-builder --linux --dir",
    "dist:mac": "vite build && electron-builder --mac --dir",
    "build:server": "vite build --ssr server/main.ts --outDir dist-server --emptyOutDir",
    "start:server": "node dist-server/main.js"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.23.0",
    "steamworks.js": "^0.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@chinese-fonts/cubic": "^3.0.0",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.2"
  },
  "main": "electron/main.cjs",
  "productName": "Realm of Embers",
  "author": "Realm of Embers Team",
  "build": {
    "appId": "com.realmofembers.game",
    "productName": "Realm of Embers",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "extraFiles": [],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "dir",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dir",
      "category": "public.app-category.role-playing-games",
      "icon": "build/icon.png"
    }
  }
}
